import os
import subprocess
import threading
import time
import urllib.request

# 1. Environment & Path Verification
base_dir = "/kaggle/working"
os.chdir(base_dir)
comfy_dir = os.path.join(base_dir, "ComfyUI")

print("⚡ [1/5] Initializing Kaggle Max Prime Environment...")

# Clone ComfyUI Core
if not os.path.exists(comfy_dir):
    subprocess.run(["git", "clone", "--depth", "1", "https://github.com/comfyanonymous/ComfyUI.git", comfy_dir], check=True)

os.chdir(comfy_dir)

# 2. Dependency Matrix & High-Speed Downloader Installation
print("📦 [2/5] Installing core dependencies, accelerators, & multi-tunnel suite...")
subprocess.run(["pip", "install", "-q", "-r", "requirements.txt"])
subprocess.run(["pip", "install", "-q", "accelerate", "transformers", "safetensors", "aiohttp", "pyngrok", "pycloudflared"])
subprocess.run(["apt-get", "install", "-y", "aria2", "-qq"])
subprocess.run(["npm", "install", "-g", "localtunnel"], check=False)

# 3. Elite Custom Nodes Suite Installation
print("🧩 [3/5] Installing Elite Custom Nodes (Manager, FaceDetailer, IP-Adapter, 4K Upscale)...")
custom_nodes_dir = os.path.join(comfy_dir, "custom_nodes")
os.makedirs(custom_nodes_dir, exist_ok=True)

elite_nodes = {
    "ComfyUI-Manager": "https://github.com/ltdrdata/ComfyUI-Manager.git",
    "ComfyUI-Impact-Pack": "https://github.com/ltdrdata/ComfyUI-Impact-Pack.git",
    "ComfyUI_IPAdapter_plus": "https://github.com/cubiq/ComfyUI_IPAdapter_plus.git",
    "ComfyUI-ControlNet-Aux": "https://github.com/Fannovel16/comfyui_controlnet_aux.git",
    "ComfyUI_UltimateSDUpscale": "https://github.com/ssitu/ComfyUI_UltimateSDUpscale.git",
    "ComfyUI-Crystools": "https://github.com/crystian/ComfyUI-Crystools.git",
    "rgthree-comfy": "https://github.com/rgthree/rgthree-comfy.git"
}

for name, url in elite_nodes.items():
    node_path = os.path.join(custom_nodes_dir, name)
    if not os.path.exists(node_path):
        subprocess.run(["git", "clone", "--depth", "1", url, node_path], check=False)
        req_file = os.path.join(node_path, "requirements.txt")
        if os.path.exists(req_file):
            subprocess.run(["pip", "install", "-q", "-r", req_file], check=False)

# 4. Multi-Threaded Model & Upscaler Downloads (350+ MB/s)
print("📥 [4/5] Verifying Master Models & 4K Upscalers...")

# Checkpoint: SDXL Base 1.0 (6.9 GB)
ckpt_dir = os.path.join(comfy_dir, "models/checkpoints")
os.makedirs(ckpt_dir, exist_ok=True)
sdxl_path = os.path.join(ckpt_dir, "sd_xl_base_1.0.safetensors")
if not os.path.exists(sdxl_path) or os.path.getsize(sdxl_path) < 1000000:
    subprocess.run(["aria2c", "-x", "16", "-s", "16", "-k", "1M", "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors", "-d", ckpt_dir, "-o", "sd_xl_base_1.0.safetensors"])

# Upscaler: 4x-UltraSharp
upscale_dir = os.path.join(comfy_dir, "models/upscale_models")
os.makedirs(upscale_dir, exist_ok=True)
upscale_path = os.path.join(upscale_dir, "4x-UltraSharp.pth")
if not os.path.exists(upscale_path):
    subprocess.run(["aria2c", "-x", "8", "-s", "8", "https://huggingface.co/uwg/upscaler/resolve/main/ESRGAN/4x-UltraSharp.pth", "-d", upscale_dir, "-o", "4x-UltraSharp.pth"])

# Face Detection Model for FaceDetailer
bbox_dir = os.path.join(comfy_dir, "models/mmdets/bbox")
os.makedirs(bbox_dir, exist_ok=True)
bbox_path = os.path.join(bbox_dir, "face_yolov8n.pt")
if not os.path.exists(bbox_path):
    subprocess.run(["aria2c", "-x", "8", "-s", "8", "https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8n.pt", "-d", bbox_dir, "-o", "face_yolov8n.pt"])

# 5. Launch Optimized Server with Multi-Tunnel Redundancy
print("🚀 [5/5] Launching ComfyUI Server & Activating Multi-Tunnel Network...")

def run_comfy_server():
    subprocess.run([
        "python", "main.py",
        "--listen", "0.0.0.0",
        "--port", "8188",
        "--enable-cors-header", "*",
        "--highvram",
        "--fast"
    ])

threading.Thread(target=run_comfy_server, daemon=True).start()
time.sleep(6)

